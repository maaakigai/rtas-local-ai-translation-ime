#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 360, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "RTAS 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "翻訳エンジンと接続先を設定します。", -1, 14, 12, 332, 12
    GROUPBOX "翻訳", -1, 12, 30, 336, 160
    LTEXT "エンジン(&E)", -1, 24, 49, 80, 12
    COMBOBOX IDC_BACKEND, 112, 45, 114, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "推論先(&D)", -1, 234, 49, 40, 12
    COMBOBOX IDC_DEVICE, 278, 45, 54, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "モデル名(&M)", -1, 24, 69, 80, 12
    COMBOBOX IDC_MODEL, 112, 65, 152, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "一覧取得(&L)", IDC_FETCH_MODELS, 270, 65, 62, 16
    LTEXT "翻訳形式(&F)", -1, 24, 89, 80, 12
    COMBOBOX IDC_PROMPT_FORMAT, 112, 85, 220, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ホスト(&H)", -1, 24, 109, 80, 12
    EDITTEXT IDC_HOST, 112, 105, 220, 16, ES_AUTOHSCROLL
    LTEXT "ポート(&P)", -1, 24, 129, 80, 12
    EDITTEXT IDC_PORT, 112, 125, 70, 16, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "HTTPS(&S)", IDC_TLS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 126, 138, 14
    LTEXT "APIパス(&A)", -1, 24, 149, 80, 12
    EDITTEXT IDC_PATH, 112, 145, 220, 16, ES_AUTOHSCROLL
    LTEXT "タイムアウト(&T)", -1, 24, 169, 85, 12
    EDITTEXT IDC_TIMEOUT, 112, 165, 70, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "ミリ秒（1000 = 1秒）", -1, 189, 169, 142, 12
    CONTROL "かな漢字変換のみを起動時の既定値にする(&K)", IDC_KANA_ONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 202, 332, 14
    LTEXT "前回のモード切替状態が保存されている場合は、その状態が優先されます。", -1, 14, 220, 332, 17
    LTEXT "編集中の設定ファイル", -1, 14, 240, 332, 12
    EDITTEXT IDC_CONFIG_PATH, 14, 254, 268, 18, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "参照(&B)…", IDC_BROWSE, 288, 254, 58, 18
    LTEXT "", IDC_STATUS, 14, 276, 332, 17
    PUSHBUTTON "再読み込み(&R)", IDC_RELOAD, 14, 296, 85, 18
    DEFPUSHBUTTON "保存", IDOK, 214, 296, 62, 18
    PUSHBUTTON "閉じる", IDCANCEL, 284, 296, 62, 18
END
