#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 360, 309
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "RTAS 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "翻訳エンジン、接続先、ゲーム辞書を設定します。", -1, 14, 8, 332, 12
    GROUPBOX "翻訳", -1, 12, 22, 336, 128
    LTEXT "エンジン(&E)", -1, 24, 37, 80, 12
    COMBOBOX IDC_BACKEND, 112, 33, 114, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "推論先(&D)", -1, 234, 37, 40, 12
    COMBOBOX IDC_DEVICE, 278, 33, 54, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "モデル名(&M)", -1, 24, 53, 80, 12
    COMBOBOX IDC_MODEL, 112, 49, 152, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "一覧取得(&L)", IDC_FETCH_MODELS, 270, 49, 62, 15
    LTEXT "翻訳形式(&F)", -1, 24, 69, 80, 12
    COMBOBOX IDC_PROMPT_FORMAT, 112, 65, 220, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ホスト(&H)", -1, 24, 85, 80, 12
    EDITTEXT IDC_HOST, 112, 81, 220, 15, ES_AUTOHSCROLL
    LTEXT "ポート(&P)", -1, 24, 101, 80, 12
    EDITTEXT IDC_PORT, 112, 97, 70, 15, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "HTTPS(&S)", IDC_TLS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 98, 138, 14
    LTEXT "APIパス(&A)", -1, 24, 117, 80, 12
    EDITTEXT IDC_PATH, 112, 113, 220, 15, ES_AUTOHSCROLL
    LTEXT "タイムアウト(&T)", -1, 24, 133, 85, 12
    EDITTEXT IDC_TIMEOUT, 112, 129, 70, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "ミリ秒（1000 = 1秒）", -1, 189, 133, 142, 12
    CONTROL "かな漢字変換のみを起動時の既定値にする(&K)", IDC_KANA_ONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 154, 332, 14
    LTEXT "前回のモード切替状態が保存されている場合は、その状態が優先されます。", -1, 14, 169, 332, 13
    GROUPBOX "Warframe 辞書", -1, 12, 183, 336, 45
    CONTROL "変換と翻訳で使う(&W)", IDC_WARFRAME_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 195, 175, 14
    PUSHBUTTON "公式データを更新(&U)", IDC_WARFRAME_UPDATE, 225, 193, 108, 17
    LTEXT "", IDC_WARFRAME_STATUS, 24, 212, 309, 13
    LTEXT "編集中の設定ファイル", -1, 14, 233, 332, 12
    EDITTEXT IDC_CONFIG_PATH, 14, 247, 268, 17, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "参照(&B)…", IDC_BROWSE, 288, 247, 58, 17
    LTEXT "", IDC_STATUS, 14, 267, 332, 17
    PUSHBUTTON "再読み込み(&R)", IDC_RELOAD, 14, 285, 85, 18
    DEFPUSHBUTTON "保存", IDOK, 214, 285, 62, 18
    PUSHBUTTON "閉じる", IDCANCEL, 284, 285, 62, 18
END
